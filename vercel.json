{
  "cleanUrls": true,
  "trailingSlash": false,
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.finagro.app"
        }
      ],
      "destination": "https://finagro.app/",
      "permanent": true
    },
    {
      "source": "/:caminho*",
      "has": [
        {
          "type": "host",
          "value": "www.finagro.app"
        }
      ],
      "destination": "https://finagro.app/:caminho*",
      "permanent": true
    },
    {
      "source": "/ig",
      "destination": "/?utm_source=instagram&utm_medium=social&utm_campaign=perfil&utm_content=bio",
      "statusCode": 302
    },
    {
      "source": "/ig/:posicao(story|reels|post|dm|anuncio)",
      "destination": "/?utm_source=instagram&utm_medium=social&utm_campaign=perfil&utm_content=:posicao",
      "statusCode": 302
    },
    {
      "source": "/historia",
      "destination": "https://projeto.finagro.app/historia",
      "permanent": true
    },
    {
      "source": "/equipe",
      "destination": "https://projeto.finagro.app/equipe",
      "permanent": true
    },
    {
      "source": "/premia%C3%A7%C3%B5es",
      "destination": "https://projeto.finagro.app/premia%C3%A7%C3%B5es",
      "permanent": true
    },
    {
      "source": "/premiações",
      "destination": "https://projeto.finagro.app/premia%C3%A7%C3%B5es",
      "permanent": true
    },
    {
      "source": "/conhe%C3%A7a-o-app",
      "destination": "https://projeto.finagro.app/conhe%C3%A7a-o-app",
      "permanent": true
    },
    {
      "source": "/conheça-o-app",
      "destination": "https://projeto.finagro.app/conhe%C3%A7a-o-app",
      "permanent": true
    },
    {
      "source": "/in%C3%ADcio",
      "destination": "https://projeto.finagro.app/in%C3%ADcio",
      "permanent": true
    },
    {
      "source": "/início",
      "destination": "https://projeto.finagro.app/in%C3%ADcio",
      "permanent": true
    },
    {
      "source": "/pol%C3%ADtica-de-privacidade",
      "destination": "https://projeto.finagro.app/pol%C3%ADtica-de-privacidade",
      "permanent": true
    },
    {
      "source": "/política-de-privacidade",
      "destination": "https://projeto.finagro.app/pol%C3%ADtica-de-privacidade",
      "permanent": true
    },
    {
      "source": "/exclus%C3%A3o-de-dados",
      "destination": "https://projeto.finagro.app/exclus%C3%A3o-de-dados",
      "permanent": true
    },
    {
      "source": "/exclusão-de-dados",
      "destination": "https://projeto.finagro.app/exclus%C3%A3o-de-dados",
      "permanent": true
    },
    {
      "source": "/siganos",
      "destination": "https://projeto.finagro.app/siganos",
      "permanent": true
    },
    {
      "source": "/sugestoes",
      "destination": "https://projeto.finagro.app/sugestoes",
      "permanent": true
    },
    {
      "source": "/termos-e-condi%C3%A7%C3%B5es-gerais-de-uso",
      "destination": "https://projeto.finagro.app/termos-e-condi%C3%A7%C3%B5es-gerais-de-uso",
      "permanent": true
    },
    {
      "source": "/termos-e-condições-gerais-de-uso",
      "destination": "https://projeto.finagro.app/termos-e-condi%C3%A7%C3%B5es-gerais-de-uso",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(telas|videos|marca|og|fontes)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
